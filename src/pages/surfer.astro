---
import BaseLayout from '@/layouts/BaseLayout.astro';

// Placeholder page for the Cardio Surfers project while the full
// showcase is still being built. Deliberately self-contained: no
// component imports, no image assets, no client JS. Everything it
// needs is inline, so it can be edited and redeployed on its own.
const REPO = 'https://github.com/Jackie-Who/cardio-surfers';
---

<BaseLayout
  title="Cardio Surfers — Jackie Hu"
  description="Play Subway Surfers by actually running. A webcam pose-tracking app that turns an endless runner into cardio. Project page in progress."
  themeColor="#080c16"
  bodyClass="surfer-body"
>
  <!-- Display + handwriting faces for the wordmark and the arrow note.
       Loaded here rather than in BaseLayout so no other route pays for
       them. -->
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Luckiest+Guy&display=swap"
    slot="head"
  />

  <main id="main" class="surfer">
    <div class="surfer-glow" aria-hidden="true"></div>

    <div class="surfer-inner">
      <p class="surfer-wordmark">Cardio<span>Surfers</span></p>
      <p class="surfer-tagline">Play Subway Surfers by actually running.</p>

      <p class="surfer-wip">
        This page is a work in progress.
      </p>

      <div class="surfer-cta">
        <p class="surfer-note">check out the project repo directly</p>

        <svg class="surfer-arrow" viewBox="0 0 220 110" fill="none" aria-hidden="true">
          <path
            d="M10 14 C 66 4, 132 16, 168 52 C 182 66, 190 82, 193 98"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
          />
          <path
            d="M177 84 L193 100 L202 78"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>

        <a class="surfer-btn" href={REPO} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path
              fill="currentColor"
              d="M8 0C3.58 0 0 3.58 0 8a8 8 0 005.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.93-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.72 1.23 1.88.87 2.34.67.07-.52.28-.88.51-1.08-1.78-.2-3.64-.89-3.64-3.96 0-.88.31-1.59.83-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.64 7.64 0 014 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.52.56.82 1.27.82 2.15 0 3.08-1.87 3.76-3.65 3.96.29.25.54.74.54 1.48v2.2c0 .22.15.46.55.38A8 8 0 0016 8c0-4.42-3.58-8-8-8z"
            />
          </svg>
          <span>View the repo</span>
        </a>
      </div>

      <a class="surfer-back" href="/">&larr; jackiehu.dev</a>
    </div>
  </main>
</BaseLayout>

<style is:global>
  .surfer-body {
    margin: 0;
    background: #080c16;
  }
</style>

<style>
  .surfer {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 24px;
    overflow: hidden;
    background: #080c16;
    color: #dbe7f5;
  }

  /* Pure-CSS backdrop — no asset to ship or keep in sync. */
  .surfer-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 50% at 50% 38%, rgba(124, 255, 79, 0.1), transparent 70%),
      radial-gradient(ellipse 50% 45% at 78% 72%, rgba(255, 79, 163, 0.09), transparent 70%),
      radial-gradient(ellipse 45% 40% at 20% 70%, rgba(56, 189, 248, 0.08), transparent 70%);
  }

  .surfer-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 620px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .surfer-wordmark {
    margin: 0;
    font-family: 'Luckiest Guy', Impact, sans-serif;
    font-size: clamp(2.1rem, 7vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #7cff4f;
    -webkit-text-stroke: 2px #06111f;
    paint-order: stroke fill;
    text-shadow:
      0 3px 0 #06111f,
      0 8px 24px rgba(0, 0, 0, 0.6);
  }

  .surfer-wordmark span {
    color: #ff4fa3;
    margin-left: 0.28em;
  }

  .surfer-tagline {
    margin: 12px 0 0;
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: clamp(0.76rem, 2.4vw, 0.92rem);
    letter-spacing: 0.02em;
    color: #7ab0d8;
  }

  .surfer-wip {
    margin: 34px 0 0;
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: clamp(0.8rem, 2.6vw, 0.95rem);
    color: #8fa6c2;
  }

  /* Note sits upper-left, arrow curves down-right into the button. */
  .surfer-cta {
    position: relative;
    margin-top: 26px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .surfer-note {
    margin: 0;
    align-self: flex-start;
    font-family: 'Caveat', 'Segoe Script', cursive;
    font-size: clamp(1.15rem, 3.6vw, 1.5rem);
    line-height: 1.2;
    color: #ffd7ea;
    transform: rotate(-3deg);
  }

  .surfer-arrow {
    width: clamp(96px, 26vw, 130px);
    height: auto;
    align-self: center;
    margin: -2px 0 2px 42px;
    color: #ff4fa3;
    opacity: 0.92;
  }

  .surfer-btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 12px 22px;
    border-radius: 999px;
    background: #7cff4f;
    color: #06111f;
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    border: 2px solid #06111f;
    box-shadow: 0 4px 0 #06111f;
    transition:
      transform 160ms ease,
      background 200ms ease,
      box-shadow 160ms ease;
  }

  .surfer-btn svg {
    width: 17px;
    height: 17px;
    flex: none;
  }

  .surfer-btn:hover,
  .surfer-btn:focus-visible {
    background: #a3ff7d;
    transform: translateY(-2px);
    box-shadow: 0 6px 0 #06111f;
  }

  .surfer-btn:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 #06111f;
  }

  .surfer-back {
    margin-top: 40px;
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: #55688a;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .surfer-back:hover,
  .surfer-back:focus-visible {
    color: #7ab0d8;
  }

  @media (prefers-reduced-motion: reduce) {
    .surfer-btn {
      transition: none;
    }
  }
</style>
